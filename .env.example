# ==============================================================================
# Environment Configuration Template: Temporal Threat Detector
# Copy this file to .env to configure local or cloud runtime environments
# ==============================================================================

# Driver mode: auto | in-memory | local | localstack | aws
TELEMETRY_DRIVER_MODE=auto

# FastAPI Backend Service
DETECTOR_API_URL=http://127.0.0.1:8000
PORT=8000

# AWS & LocalStack Configuration
AWS_DEFAULT_REGION=us-east-1
# Uncomment to target LocalStack (port 4566)
# AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Cloud Resource Names
TELEMETRY_QUEUE_NAME=cloud-workload-telemetry-queue
TELEMETRY_DLQ_NAME=cloud-workload-telemetry-queue-dlq
ALERTS_TABLE_NAME=temporal-threat-alerts
TELEMETRY_BUCKET_NAME=temporal-threat-telemetry-archive

# Window & Detection Ensemble Parameters
WINDOW_SIZE_SECONDS=60.0
WINDOW_HOP_SECONDS=10.0
ZSCORE_THRESHOLD=3.0
ISOLATION_FOREST_CONTAMINATION=0.03
